{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "MiniWin: Build current file",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "if (Test-Path \"${fileDirname}\\miniwin.cpp\") { g++ \"${file}\" \"${fileDirname}\\miniwin.cpp\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\" -lgdi32 -luser32 -lkernel32 } else { g++ \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\" }"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "MiniWin: Build and run current file",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "if (Test-Path \"${fileDirname}\\miniwin.cpp\") { g++ \"${file}\" \"${fileDirname}\\miniwin.cpp\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\" -lgdi32 -luser32 -lkernel32; if ($LASTEXITCODE -eq 0) { & \"${fileDirname}\\${fileBasenameNoExtension}.exe\" } } else { g++ \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\"; if ($LASTEXITCODE -eq 0) { & \"${fileDirname}\\${fileBasenameNoExtension}.exe\" } }"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": "build",
            "problemMatcher": "$gcc"
        }
    ]
}